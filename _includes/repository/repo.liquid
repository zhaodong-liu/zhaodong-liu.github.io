{% assign repo_name = include.repository | split: '/' | last %}
{% assign details = site.data.repositories.repo_details[include.repository] %}
<a class="repository-card" href="https://github.com/{{ include.repository | escape }}">
  <h3 class="repository-card-title">{{ repo_name | escape }}</h3>
  <p class="repository-card-owner">{{ include.repository | escape }}</p>
  {% if details %}
    <p class="repository-card-description">
      <span class="lang-en">{{ details.description_en | escape }}</span>
      <span class="lang-zh">{{ details.description_zh | escape }}</span>
    </p>
  {% endif %}
  <span class="repository-card-action"><span class="lang-en">View repository</span><span class="lang-zh">查看仓库</span> &rarr;</span>
</a>
